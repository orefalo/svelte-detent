{
  "name": "@hayderkg/detent-svelte",
  "version": "0.1.1",
  "description": "A wheel picker for Svelte 5 that clicks into place.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayderkg/detent.git",
    "directory": "svelte"
  },
  "homepage": "https://detent.hayder.sh",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite --config demo/vite.config.ts demo --open"
  },
  "peerDependencies": {
    "@hayderkg/detent": "^0.1.1",
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@hayderkg/detent": "workspace:^",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
