{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "printWidth": 120,
  "ignorePatterns": [
    "dist",
    "demo-dist",
    ".svelte-kit",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "demo/docs/docs.md",
    "**/*.svelte",
    "demo/**",
    "test/fixtures/**"
  ]
}
