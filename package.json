{
  "name": "svelte-detent",
  "version": "0.2.0",
  "description": "A wheel picker for Svelte 5 that clicks into place.",
  "keywords": [
    "ios",
    "odometer",
    "picker",
    "rolling-text",
    "scroll-picker",
    "svelte",
    "svelte5",
    "wheel-picker"
  ],
  "homepage": "https://orefalo.github.io/svelte-detent/",
  "bugs": {
    "url": "https://github.com/orefalo/svelte-detent/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orefalo/svelte-detent.git"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts --open",
    "build": "svelte-package -i src/lib -o dist",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "marked": "^18.1.3",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "packageManager": "pnpm@12.16.1"
}
